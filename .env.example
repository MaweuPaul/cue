# Copy this file to .env and fill in your keys.
# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: get a free key (one-time $200 credit) at https://console.deepgram.com/signup
# for real-time streaming transcription. If left unset, falls back to local
# faster-whisper (slower, batch-based, but fully offline/free).
DEEPGRAM_API_KEY=your-deepgram-key-here

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
WHISPER_MODEL=small.en
# cpu or cuda (cuda only if you have an NVIDIA GPU + CUDA toolkit installed)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Required by server.py (the phone/web version) so random devices on your
# WiFi can't connect and use your API quota. Pick any PIN.
ACCESS_PIN=changeme

# Toggle capture sources independently - useful to avoid double-detecting the
# same speech via both channels when they're too acoustically close together.
CAPTURE_SYSTEM_AUDIO=true
CAPTURE_MIC=true
